# ─── Database ──────────────────────────────────────────────
# Su Railway viene generata automaticamente quando crei il servizio Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/quitfresh"

# ─── Auth ──────────────────────────────────────────────────
# Stringa casuale, minimo 32 caratteri. Generala con: openssl rand -base64 32
# Il server crasha all'avvio se è mancante o più corta di 32 caratteri.
# Non cambiarla in prod: invalida tutti i token JWT degli utenti loggati.
JWT_SECRET=genera-con-openssl-rand-base64-32  # minimo 32 caratteri

# ─── OpenAI (chat coach) ───────────────────────────────────
# GDPR: vai su platform.openai.com → Settings → Data Controls
# e disabilita "Improve model for everyone" prima del lancio.
OPENAI_API_KEY=

# ─── Client URL (per CORS e Stripe redirect) ───────────────
# Es. https://alessiovinci87.github.io
CLIENT_URL="https://alessiovinci87.github.io"
# Path base del client su GitHub Pages (default: /quitfresh).
# Usato per costruire success_url/cancel_url di Stripe Checkout.
CLIENT_BASE_PATH="/quitfresh"
# Base URL del frontend per i link di verify-email / reset-password.
# Es. https://alessiovinci87.github.io/quitfresh
CLIENT_BASE_URL="https://alessiovinci87.github.io/quitfresh"

# ─── CORS extra origins ────────────────────────────────────
# Origin aggiuntivo da accettare oltre a https://alessiovinci87.github.io.
# Usalo per dev (http://localhost:5173) o staging.
CORS_ORIGIN="http://localhost:5173"

# ─── Resend (invio email transazionali) ────────────────────
# Verifica account + reset password.
# RESEND_API_KEY: chiave API da resend.com (re_xxx)
# RESEND_FROM_EMAIL: mittente verificato, es. "QuitFresh <noreply@tuodominio.it>"
# Se queste variabili mancano, l'invio è no-op (log a console).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# ─── Notifiche admin ───────────────────────────────────────
# Indirizzo a cui mandare le notifiche admin (es. quando un utente
# usa un codice sconto). Accetta uno o piu' indirizzi separati da
# virgola, es: "info@quitfresh.it,backup@example.com". Se vuoto,
# fallback su BACKUP_EMAIL_TO. Se entrambi vuoti, le notifiche sono
# no-op (loggate a console).
ADMIN_NOTIFY_EMAIL=""

# ─── Push notifications (VAPID) ────────────────────────────
# Generare con: npx web-push generate-vapid-keys
# Attenzione: copia/incolla può aggiungere caratteri invisibili. Il codice
# sanitizza, ma in caso di errori verifica che siano alfanumerici + - _
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:tuo@email.it"

# ─── Stripe (premium €2.99) ────────────────────────────────
# 1. Crea un Prodotto su Stripe Dashboard con prezzo one-time €2.99.
#    Copia il price_... ID in STRIPE_PRICE_ID.
# 2. STRIPE_SECRET_KEY: chiave segreta dal Dashboard (sk_live_ in prod, sk_test_ in test).
# 3. STRIPE_WEBHOOK_SECRET: ottenuto dopo aver registrato il webhook URL
#    https://<tuo-backend>/api/payments/webhook su Stripe Dashboard,
#    selezionando l'evento "checkout.session.completed".
#
# Se queste variabili sono assenti, il gate premium è disattivato
# (l'intera app resta accessibile a tutti — utile per ambienti di sviluppo).
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# ─── Sentry (error tracking) ───────────────────────────────
# DSN del progetto Node su sentry.io. Lasciare vuoto disattiva Sentry
# (utile in dev). In prod tieni alta priorità: senza, gli errori non
# arrivano da nessuna parte.
SENTRY_DSN=

# ─── Server ────────────────────────────────────────────────
# Railway imposta automaticamente PORT. Solo override per dev locale.
PORT=3001
