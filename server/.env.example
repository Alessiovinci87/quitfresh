# ─── Database ──────────────────────────────────────────────
# Su Railway viene generata automaticamente quando crei il servizio Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/quitfresh"

# ─── Auth ──────────────────────────────────────────────────
# Stringa casuale lunga 40+ caratteri. Generala una volta e non cambiarla
# (cambiarla invalida tutti i token JWT degli utenti loggati).
JWT_SECRET="cambia-questo-con-una-stringa-sicura-lunga-almeno-32-caratteri"

# ─── OpenAI (chat coach) ───────────────────────────────────
OPENAI_API_KEY="sk-..."

# ─── Client URL (per CORS e Stripe redirect) ───────────────
# Es. https://alessiovinci87.github.io
CLIENT_URL="https://alessiovinci87.github.io"
# Path base del client su GitHub Pages (default: /quitfresh).
# Usato per costruire success_url/cancel_url di Stripe Checkout.
CLIENT_BASE_PATH="/quitfresh"

# ─── Push notifications (VAPID) ────────────────────────────
# Generare con: npx web-push generate-vapid-keys
# Attenzione: copia/incolla può aggiungere caratteri invisibili. Il codice
# sanitizza, ma in caso di errori verifica che siano alfanumerici + - _
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:tuo@email.it"

# ─── Stripe (premium €4.99) ────────────────────────────────
# 1. Crea un Prodotto su Stripe Dashboard con prezzo one-time €4.99.
#    Copia il price_... ID in STRIPE_PRICE_ID.
# 2. STRIPE_SECRET_KEY: chiave segreta dal Dashboard (sk_live_ in prod, sk_test_ in test).
# 3. STRIPE_WEBHOOK_SECRET: ottenuto dopo aver registrato il webhook URL
#    https://<tuo-backend>/api/payments/webhook su Stripe Dashboard,
#    selezionando l'evento "checkout.session.completed".
#
# Se queste variabili sono assenti, il gate premium è disattivato
# (la chat AI resta accessibile a tutti — utile per ambienti di sviluppo).
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# ─── Server ────────────────────────────────────────────────
# Railway imposta automaticamente PORT. Solo override per dev locale.
PORT=3001
