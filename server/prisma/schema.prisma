generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  createdAt         DateTime           @default(now())
  cigarettesPerDay  Int?
  criticalMoments   String[]
  dependencyLevel   Int?
  quitDate           DateTime?
  cytisineStartDate  DateTime?
  firstDoseTime      String?
  smokeFreeSince     DateTime?
  notificationTimes  String[]
  encouragementTime  String?
  streakFreezesUsed  Int                @default(0)
  cytisineSchedule   Json?
  cigarettePackPrice Float              @default(5.80)
  isPremium          Boolean            @default(false)
  premiumSince       DateTime?
  stripeCustomerId   String?            @unique
  promoCodeUsed      String?
  resetToken         String?            @unique
  resetTokenExp      DateTime?
  emailVerified      Boolean            @default(false)
  verifyToken        String?            @unique
  isAdmin            Boolean            @default(false)
  // tokenVersion: incrementato al reset password e a logout-all per
  // invalidare TUTTI i JWT esistenti dell'utente. Middleware requireAuth
  // compara payload.tv === user.tokenVersion.
  tokenVersion       Int                @default(0)
  cravingLogs       CravingLog[]
  quitAttempts      QuitAttempt[]
  diaryEntries      DiaryEntry[]
  pushSubscriptions PushSubscription[]
}

model PromoCode {
  id           String    @id @default(cuid())
  code         String    @unique
  discountPct  Int
  active       Boolean   @default(true)
  usageCount   Int       @default(0)
  maxUses      Int?
  expiresAt    DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
}

model CravingLog {
  id        String   @id @default(cuid())
  userId    String
  timestamp DateTime @default(now())
  context   String   @default("")
  resolved  Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuitAttempt {
  id        String    @id @default(cuid())
  userId    String
  startDate DateTime
  endDate   DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DiaryEntry {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime
  pillsTaken      Int      @default(0)
  cigarettesToday Int      @default(0)
  sideEffects     String[]
  notes           String   @default("")
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  endpoint String @unique
  p256dh   String
  auth     String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
